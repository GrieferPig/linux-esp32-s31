# ESP32-S31 XIP + MMU (Sv32) S-mode minimal defconfig
# Kernel executes from the Linux flash XIP partition at 0x40400000; writable
# data is copied to cached PSRAM at 0x50000000. It runs in Supervisor mode
# behind OpenSBI.
CONFIG_MMU=y
# CONFIG_RISCV_M_MODE is not set
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x40400000
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x50000000
CONFIG_SPARSEMEM_MANUAL=y
CONFIG_SPARSEMEM=y
CONFIG_RISCV_SPARSEMEM_SECTION_SIZE_BITS=24
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_BASE_SMALL=y
# CONFIG_CLINT_TIMER is not set

# CONFIG_CPU_ISOLATION is not set
CONFIG_LOG_BUF_SHIFT=14
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable heavyweight syscalls / features
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_FHANDLE is not set
# CONFIG_BASE_FULL is not set
# CONFIG_FUTEX is not set
# CONFIG_EPOLL is not set
CONFIG_SIGNALFD=y
# CONFIG_TIMERFD is not set
CONFIG_EVENTFD=y
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_COMPAT_BRK is not set

CONFIG_SLUB=y
CONFIG_SLUB_TINY=y

# Short-lived userspace peaks spill to USB swap.  Do not reserve RAM for a
# compressed-RAM block device on the 16 MiB board.
CONFIG_SWAP=y
# CONFIG_ZRAM is not set

# RISC-V 32-bit
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set
CONFIG_ARCH_ESPRESSIF=y
CONFIG_SOC_ESP32S31=y
CONFIG_ESP32S31_COPROC_CONTEXT=y
CONFIG_ESP32S31_RADIO_SMODE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_ESP32S31_RADIO_SMODE_DRIVER=m
CONFIG_ESP32S31_RADIO_BLOBS=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_ESP32S31_CLOCK=y
CONFIG_PM=y
CONFIG_PM_DEBUG=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE=y
# CONFIG_RISCV_SBI_CPUIDLE is not set
CONFIG_ESP32S31_CPUIDLE=y
CONFIG_ESP32S31_PMU=y
CONFIG_REGULATOR_ESP32S31_ANA_I2C=y
CONFIG_ESP32S31_CACHE=y
CONFIG_DMADEVICES=y
CONFIG_ESP32S31_AXI_GDMA=y
CONFIG_ESP32S31_AHB_GDMA=y
CONFIG_CRYPTO_DEV_ESP32S31=y
CONFIG_CRYPTO_AKCIPHER=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_DMATEST=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ESP32S31=y
CONFIG_ESP32S31_DT_OVERLAY=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_NVMEM=y
CONFIG_NVMEM_ESP32S31_EFUSE=y
CONFIG_WATCHDOG=y
CONFIG_ESP32S31_WATCHDOG=y
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
CONFIG_PWM_ESP32S31_LEDC=y
CONFIG_PWM_ESP32S31_MCPWM=y
CONFIG_PWM_ESP32S31_SDM=y
CONFIG_COUNTER=y
CONFIG_ESP32S31_PCNT=y
CONFIG_ESP32S31_SYSTEM_TIMERS=y
CONFIG_ESP32S31_GPTIMER=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_ESP32S31_ADC=y
CONFIG_ESP32S31_DAC=y
CONFIG_ESP32S31_TOUCH=y
CONFIG_ESP32S31_COMPARATOR=y
CONFIG_HWMON=y
CONFIG_SENSORS_ESP32S31_TSENS=y
# CONFIG_ESP32S31_IRQ_MATRIX is not set
# CONFIG_ESP32S31_PCR is not set

CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_ESP32S31_SYSTIMER_CLOCKSOURCE=y
CONFIG_THREAD_SIZE_ORDER=2
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
CONFIG_FPU=y

# Kernel command line
CONFIG_CMDLINE="console=ttyS0,115200n8 rootfstype=squashfs ro init=/init clk_ignore_unused irqaffinity=0 esp32s31_idle=wfi"
CONFIG_CMDLINE_FORCE=y

# U-Boot passes the board DTB in a1, matching the upstream RISC-V boot ABI.
# CONFIG_BUILTIN_DTB is not set

# Security (minimal)
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_GCC_PLUGINS is not set
CONFIG_LSM="[]"

# Block layer — strip to minimum
CONFIG_BLOCK=y
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_BLK_DEV_BSG is not set

# Executable format
CONFIG_BINFMT_ELF=y
# CONFIG_COREDUMP is not set

# Devtmpfs (so /dev nodes appear automatically)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking — keep minimal for future use
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_INET_TABLE_PERTURB_ORDER=8
# CONFIG_IPV6_SIT is not set
# CONFIG_INET_DIAG is not set

# Firmware loader / core dumps — off
CONFIG_FW_LOADER=y
# CONFIG_ALLOW_DEV_COREDUMP is not set

# Input — keep minimal, but provide uinput for BlueZ AVRCP/A2DP profiles.
CONFIG_INPUT=y
# CONFIG_INPUT_MOUSEDEV is not set
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# I2C master adapters; controller instances remain opt-in DT overlays.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_ESP32S31=y
CONFIG_I2C_SLAVE=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
# CONFIG_CAN_BCM is not set
# CONFIG_CAN_GW is not set
CONFIG_CAN_DEV=y
CONFIG_CAN_CTUCANFD=y
CONFIG_CAN_CTUCANFD_PLATFORM=y
# SPI is enabled below with the S31 GPSPI controller.

# USB mass storage is built in because the swap device is needed during boot.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Synopsys DesignWare SDMMC controller
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y

# Integrated DesignWare USB2 host and UTMI PHY
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_ESP32S31_GP_LDO=y
CONFIG_USB_STORAGE=y
# CONFIG_USB_UAS is not set
CONFIG_PHY_ESP32S31_USB=y

# Synopsys DesignWare GMAC controller
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_BT=y
CONFIG_BT_LE=y
# CONFIG_BT_ESP32S31 is not set
# CONFIG_BT_BREDR is not set
# CONFIG_BT_BNEP is not set
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
CONFIG_WLAN_VENDOR_ESPRESSIF=y
CONFIG_ESP32S31_WIFI=y

# Bootloader-mapped SPI Flash, exported as fixed writable MTD partitions
CONFIG_MTD=y
CONFIG_MTD_CHAR=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_PARTITIONED_MASTER=y
CONFIG_MTD_ESP32S31_FLASH=y
CONFIG_MAILBOX=y
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_CDEV=y
CONFIG_ESP32S31_LP_REMOTEPROC=y
CONFIG_MFD_SYSCON=y

# Serial / TTY — on
# CONFIG_SERIO is not set
# CONFIG_VT is not set
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set

# ESP32-S31 hardware RNG
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ESP32S31=y
# CONFIG_DEVMEM is not set

# Virtualisation I/O — off
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# Filesystems — initramfs plus FAT-formatted removable storage
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# CONFIG_FILE_LOCKING is not set
# CONFIG_DNOTIFY is not set
CONFIG_INOTIFY_USER=y
CONFIG_MISC_FILESYSTEMS=y

# Debug / printk
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# CONFIG_FRAME_POINTER is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_ESP32=y
CONFIG_SERIAL_ESP32_UHCI=y
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_SPI=y
CONFIG_SPI_SLAVE=y
CONFIG_SPI_ESP32S31=y
CONFIG_SPI_SPIDEV=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ESP32S31_I2S=y
# CONFIG_SND_VERBOSE_PROCFS is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set

CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_DECOMPRESS_GZIP=y

CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_WRITEBUFFER=y
CONFIG_JFFS2_FS_XATTR=y
# CONFIG_JFFS2_FS_POSIX_ACL is not set
# CONFIG_JFFS2_FS_SECURITY is not set
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_EMBEDDED=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=1
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_100=y
