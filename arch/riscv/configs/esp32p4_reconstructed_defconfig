# Independent reconstruction. Original v4 IKCONFIG was not embedded.
CONFIG_EXPERT=y
CONFIG_ARCH_RV32I=y
# CONFIG_MMU is not set
CONFIG_RISCV_M_MODE=y
CONFIG_ARCH_ESPRESSIF=y
CONFIG_SOC_ESP32P4=y
CONFIG_NONPORTABLE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_RISCV_BOOT_SPINWAIT=y
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x48000000
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_100=y
CONFIG_PRINTK_TIME=y
CONFIG_BINFMT_FLAT=y
# CONFIG_BINFMT_ELF is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE="/workspace/scratch/esp32p4-linux/evidence/v4-initramfs.cpio"
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_ESP32=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_ESP32P4=y
CONFIG_FONT_8x16=y
CONFIG_CMDLINE="earlycon=esp32p4uart,mmio32,0x500ca000 console=tty0 console=ttyS0,115200 rdinit=/init"
CONFIG_CMDLINE_EXTEND=y
# CONFIG_BLOCK is not set
# CONFIG_NET is not set
# CONFIG_MODULES is not set
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KALLSYMS is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_COREDUMP is not set
# CONFIG_SLUB_DEBUG is not set
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-p4-reconstructed"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_DWARF4=y
