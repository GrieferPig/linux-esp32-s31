menu "SoC selection"

config ARCH_ANDES
	bool "Andes SoCs"
	depends on MMU && !XIP_KERNEL
	select ERRATA_ANDES
	help
	  This enables support for Andes SoC platform hardware.

config ARCH_ESWIN
	bool "ESWIN SoCs"
	help
	  This enables support for ESWIN SoC platform hardware,
	  including the ESWIN EIC7700 SoC.

config ARCH_MICROCHIP_POLARFIRE
	def_bool ARCH_MICROCHIP

config ARCH_MICROCHIP
	bool "Microchip SoCs"
	help
	  This enables support for Microchip SoC platforms.

config ARCH_RENESAS
	bool "Renesas RISC-V SoCs"
	help
	  This enables support for the RISC-V based Renesas SoCs.

config ARCH_SIFIVE
	bool "SiFive SoCs"
	select ERRATA_SIFIVE if !XIP_KERNEL
	help
	  This enables support for SiFive SoC platform hardware.

config ARCH_SOPHGO
	bool "Sophgo SoCs"
	help
	  This enables support for Sophgo SoC platform hardware.

config ARCH_SPACEMIT
	bool "SpacemiT SoCs"
	select PINCTRL
	help
	  This enables support for SpacemiT SoC platform hardware.

config ARCH_STARFIVE
	def_bool SOC_STARFIVE

config SOC_STARFIVE
	bool "StarFive SoCs"
	select PINCTRL
	select RESET_CONTROLLER
	select ARM_AMBA
	help
	  This enables support for StarFive SoC platform hardware.

config ARCH_SUNXI
	bool "Allwinner sun20i SoCs"
	depends on MMU && !XIP_KERNEL
	select ERRATA_THEAD
	select SUN4I_TIMER
	help
	  This enables support for Allwinner sun20i platform hardware,
	  including boards based on the D1 and D1s SoCs.

config ARCH_THEAD
	bool "T-HEAD RISC-V SoCs"
	depends on MMU && !XIP_KERNEL
	select ERRATA_THEAD
	select PM_GENERIC_DOMAINS if PM
	help
	  This enables support for the RISC-V based T-HEAD SoCs.

config ARCH_VIRT
	bool "QEMU Virt Machine"
	select POWER_RESET
	select POWER_RESET_SYSCON
	select POWER_RESET_SYSCON_POWEROFF
	select GOLDFISH
	select RTC_DRV_GOLDFISH if RTC_CLASS
	select PM_GENERIC_DOMAINS if PM
	select PM_GENERIC_DOMAINS_OF if PM && OF
	select RISCV_SBI_CPUIDLE if CPU_IDLE && RISCV_SBI
	help
	  This enables support for QEMU Virt Machine.

config ARCH_CANAAN
	bool "Canaan Kendryte SoC"
	help
	  This enables support for Canaan Kendryte series SoC platform hardware.

config SOC_CANAAN_K210
	bool "Canaan Kendryte K210 SoC"
	depends on !MMU && ARCH_CANAAN
	select ARCH_HAS_RESET_CONTROLLER
	select PINCTRL
	select COMMON_CLK
	help
	  This enables support for Canaan Kendryte K210 SoC platform hardware.

config ARCH_ESPRESSIF
	bool "Espressif RISC-V SoCs"
	help
	  This enables support for Espressif RISC-V SoCs.

config SOC_ESP32S31
	bool "Espressif ESP32-S31 SoC"
	depends on ARCH_ESPRESSIF
	select ESP32S31_CLIC
	help
	  This enables support for the Espressif ESP32-S31 SoC.
	  With MMU enabled the kernel runs in Supervisor mode behind OpenSBI.

config ESP32S31_COPROC_CONTEXT
	bool "ESP32-S31 HWLoop/PIE task context through SBI"
	depends on SOC_ESP32S31
	help
	  Save and restore the stateful HWLoop and PIE extensions on task
	  switches, fork and signal delivery.  The extension state CSRs are
	  M-mode-only, so this requires a synchronous SBI ecall on every context
	  switch.  OpenSBI strips M-CLIC metadata when redirecting traps so an
	  ecall cannot restore the cross-privilege SIL=0xff sentinel into S-mode.
	  PIE state is saved only on hart 1; users of XespV must stay CPU1-bound.

config ESP32S31_RADIO_SCHEDULER
	bool "ESP32-S31 explicit radio scheduling admission"
	depends on SOC_ESP32S31 && SMP && ESP32S31_COPROC_CONTEXT && FPU
	depends on RT_MUTEXES && PREEMPTION
	default n
	help
	  Permit an owner to admit a dormant fixed-CPU0 radio kthread. Its
	  scheduler role is not inherited by fork. An actually selected admitted
	  RT task, or its top-PI dependency, may precede the deadline fair server;
	  real deadline tasks and ordinary RT reservations retain their policy.
	  This does not bypass configured RT-group quotas, make cache-off code
	  preemptible, or authorize a vendor callback in an unsafe IRQ context.

config ESP32S31_RADIO_SMODE
	bool "ESP32-S31 S-mode radio runtime"
	depends on SOC_ESP32S31 && MMU && 32BIT && !RISCV_M_MODE
	select IRQ_STACKS
	help
	  Support native ESP32-S31 radio tasks in supervisor mode, including
	  registered SRAM stacks and canonical sscratch thread identity at traps
	  and firmware imports. Immutable peripheral/cache/SRAM/ROM supervisor
	  leaves are shared by every address space. Native radio IRQ execution
	  leases CPU0's independent Linux IRQ stack in internal SRAM.

endmenu # "SoC selection"
