// SPDX-License-Identifier: GPL-2.0+
/*
 * Espressif ESP32-S31 minimal Device Tree Source.
 */

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "espressif,esp32s31";

	memory@50000000 {
		device_type = "memory";
		/* 15MB cached PSRAM; the top 1MB is reserved for OpenSBI. */
		reg = <0x50000000 0x00F00000>;
	};

	aliases {
		serial0 = &uart0;
		serial1 = &usb_serial_jtag;
		mmc0 = &sdmmc;
		ethernet0 = &emac;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <320000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "espressif,esp32s31", "riscv";
			reg = <0>;
			riscv,isa = "rv32imabcn_zba_zbb";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zba", "zbb", "c",
					       "zicntr", "zicsr", "zifencei";
			mmu-type = "riscv,sv32";
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
			};
		};
	};

	xtal: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	/*
	 * These clocks are established by bootloader/main before the OpenSBI
	 * handoff.  They are deliberately fixed-clock providers: Linux has no S31
	 * clock/power-domain controller yet, so it must not attempt to retune or
	 * gate the underlying MPLL and CNNT SRAM domains.
	 */
	s31_sys_clk: system-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <80000000>;
	};

	sdmmc_ciu_clk: sdmmc-ciu-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* MPLL 500 MHz / bootloader-programmed divider 8. */
		clock-frequency = <62500000>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;
		dma-noncoherent;

		cache: cache-controller@2c000000 {
			compatible = "espressif,esp32s31-cache";
			reg = <0x2c000000 0x1000>;
			espressif,icache-id = <0>;
		};

		axi_gdma: dma-controller@20348000 {
			compatible = "espressif,esp32s31-axi-gdma";
			/* Reclaim bootloader-only internal DRAM after Linux handoff. */
			reg = <0x20348000 0x1000>, <0x20587078 0x4>,
			      <0x2f070000 0x8000>;
			reg-names = "dma", "clkrst", "descriptors";
			interrupt-parent = <&clic>;
			interrupts = <33 48 IRQ_TYPE_LEVEL_HIGH>,
				     <34 49 IRQ_TYPE_LEVEL_HIGH>,
				     <35 50 IRQ_TYPE_LEVEL_HIGH>,
				     <36 51 IRQ_TYPE_LEVEL_HIGH>,
				     <37 52 IRQ_TYPE_LEVEL_HIGH>,
				     <38 53 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "rx0", "rx1", "rx2",
					  "tx0", "tx1", "tx2";
			/* pair index, AXI peripheral trigger (LCD=0 .. SHA=5) */
			#dma-cells = <2>;
			dma-channels = <3>;
			status = "okay";
		};

		/*
		 * The SDMMC and GMAC IP blocks are DesignWare cores.  The S31
		 * gate/reset and SRAM low-power controls live in HP_SYS_CLKRST and
		 * CNNT_SYS respectively, rather than in either core.  Do not bind
		 * either core to the 40 MHz crystal: SDMMC is sourced from MPLL with
		 * a programmable divider and GMAC has independently selectable MAC
		 * and PTP clocks.
		 *
		 * The bootloader prepares the gates, reset state, pinmux and SRAM power
		 * domains, then leaves them on for Linux.  A future S31 clock/genpd
		 * controller must replace the fixed clocks before runtime PM or clock
		 * rate changes are enabled.
		 */
		sdmmc: mmc@20342000 {
			compatible = "snps,dw-mshc";
			reg = <0x20342000 0x1000>;
			interrupt-parent = <&clic>;
			/* raw CLIC interrupt, IDF ETS_SDIO_HOST_INTR_SOURCE */
			interrupts = <16 3 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&s31_sys_clk>, <&sdmmc_ciu_clk>;
			clock-names = "biu", "ciu";
			bus-width = <4>;
			cap-sd-highspeed;
			cap-sdio-irq;
			status = "okay";
		};

		emac: ethernet@20350000 {
			compatible = "snps,dwmac";
			/* MAC (0x0), PTP (0x700), and DMA (0x1000) register banks. */
			reg = <0x20350000 0x2000>;
			interrupt-parent = <&clic>;
			/* raw CLIC interrupt, IDF ETS_SBD_INTR_SOURCE */
			interrupts = <17 117 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&s31_sys_clk>, <&s31_sys_clk>, <&xtal>;
			clock-names = "stmmaceth", "pclk", "ptp_ref";
			/* ESP32-S31-Function-CoreBoard-1 onboard YT8531DC-CA. */
			phy-mode = "rgmii-rxid";
			phy-handle = <&yt8531>;
			status = "okay";

			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;

				yt8531: ethernet-phy@0 {
					compatible = "ethernet-phy-id4f51.e91b";
					reg = <0>;
					/* PHY strap: RXDLY enabled, TXDLY disabled. */
					rx-internal-delay-ps = <1950>;
					motorcomm,auto-sleep-disabled;
				};
			};
		};

		/* Entire 16 MiB Flash, mapped by the bootloader at a non-XIP alias. */
		flash: flash@41000000 {
			compatible = "espressif,esp32s31-flash-mtd";
			reg = <0x41000000 0x01000000>;
		};

		usb_phy: phy@20380000 {
			compatible = "espressif,esp32s31-usb-phy";
			reg = <0x20380000 0x20>, <0x205870ac 0x4>,
			      <0x20359030 0x4>, <0x20589024 0x4>,
			      <0x205890b0 0x4>;
			reg-names = "utmi", "clkrst", "otg-ctrl", "usb-ctrl",
				    "phy-ctrl";
			#phy-cells = <0>;
		};

		usb_otghs: usb@20300000 {
			compatible = "espressif,esp32s31-dwc2", "snps,dwc2";
			/* Internal SRAM used for DWC2's status-stage bit bucket. */
			reg = <0x20300000 0x1000>, <0x2f050000 0x40>;
			reg-names = "core", "local-mem";
			interrupt-parent = <&clic>;
			interrupts = <39 99 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb_phy>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			status = "okay";
		};

		clic: interrupt-controller@10a00000 {
			#interrupt-cells = <3>;
			#address-cells = <0>;
			compatible = "espressif,esp32s31-clic";
			reg = <0x10a00000 0x20000>;
			interrupt-controller;
			espressif,num-interrupts = <48>;
		};

		uart0: serial@2038a000 {
			compatible = "esp,esp32s3-uart";
			reg = <0x2038a000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <32 9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal>;
			status = "okay";
		};

		usb_serial_jtag: serial@20391000 {
			compatible = "esp,esp32-usb-serial-jtag", "esp,esp32s3-acm";
			reg = <0x20391000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <22 2 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};
	};
};
