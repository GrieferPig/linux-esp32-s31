/*
 * ESP32-S31 Device Tree Source
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31 S-mode (generic)";
	compatible = "espressif,esp32s31";

	chosen {
		bootargs = "earlycon=esp32s3uart,mmio32,0x2038a000 console=ttyS0,115200 root=/dev/mtdblock7 rootfstype=squashfs ro rootwait init=/init";
		stdout-path = "serial0:115200n8";
	};
};

&uart0 { status = "okay"; };
