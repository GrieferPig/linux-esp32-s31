/*
 * ESP32-S31 Device Tree Source
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31 S-mode (generic)";
	compatible = "espressif,esp32s31";

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart0 { status = "okay"; };

/*
 * Dual-OS baseline: these DMA masters cannot currently access Linux's
 * uncached PSRAM alias. Keep them quiescent until their DMA address
 * translation is implemented; the dedicated SRAM carve-outs remain in the
 * SoC dtsi so they can be enabled independently later.
 */
&axi_gdma { status = "disabled"; };
&sdmmc { status = "disabled"; };
&emac { status = "disabled"; };
&usb_otghs { status = "disabled"; };
