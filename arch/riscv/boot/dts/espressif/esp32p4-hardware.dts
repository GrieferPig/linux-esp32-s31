/dts-v1/;

/ {
	model = "Espressif ESP32-P4 v1.3 IDF hardware handoff";
	compatible = "espressif,esp32p4-generic\0espressif,esp32p4";
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	chosen {
		ranges;
		bootargs = "console=tty0 console=ttyS0,115200";
		#size-cells = <0x01>;
		#address-cells = <0x01>;
		espressif,cache-sync-entry = <0x00>;
		espressif,cpu1-boot-mailbox = <0x00 0x1c>;
		espressif,chip-revision = <0x67>;
		stdout-path = "serial0:115200n8";

		framebuffer@49000000 {
			interrupts = <0x18 0x04>;
			interrupt-parent = <0x01>;
			espressif,display-service-entry = <0x00>;
			espressif,cache-writeback-entry = <0x00>;
			status = "disabled";
			format = "r5g6b5";
			stride = <0x5a0>;
			height = <0x500>;
			width = <0x2d0>;
			reg = <0x49000000 0x1c2000>;
			compatible = "espressif,esp32p4-idf-framebuffer";
		};
	};

	aliases {
		serial0 = "/soc/serial@500ca000";
	};

	memory@48000000 {
		device_type = "memory";
		reg = <0x48000000 0x1000000>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		framebuffer@49000000 {
			no-map;
			reg = <0x49000000 0x1c2000>;
		};

		boot-dtb@48f00000 {
			reg = <0x48f00000 0x10000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <0x15752a00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "espressif,esp32p4-cpu\0riscv";
			reg = <0x00>;
			status = "okay";
			riscv,isa = "rv32imafc_zicsr_zifencei";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i\0m\0a\0f\0c\0zicsr\0zifencei";
			clock-frequency = <0x15752a00>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "espressif,esp32p4-cpu\0riscv";
			reg = <0x01>;
			status = "okay";
			riscv,isa = "rv32imafc_zicsr_zifencei";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i\0m\0a\0f\0c\0zicsr\0zifencei";
			clock-frequency = <0x15752a00>;
		};
	};

	clock-xtal {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x2625a00>;
		phandle = <0x02>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		interrupt-controller@20800000 {
			compatible = "espressif,esp32p4-interrupt-controller";
			reg = <0x20800000 0x12000 0x500d6000 0x1000 0x500e5000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x01>;
		};

		timer@500e2000 {
			compatible = "espressif,esp32p4-systimer";
			reg = <0x500e2000 0x1000 0x500e6000 0x1000>;
			interrupt-parent = <0x01>;
			interrupts = <0x35 0x04 0x36 0x04>;
		};

		serial@500ca000 {
			compatible = "espressif,esp32p4-uart";
			reg = <0x500ca000 0x1000>;
			clocks = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x1f 0x04>;
			status = "okay";
		};
	};
};
