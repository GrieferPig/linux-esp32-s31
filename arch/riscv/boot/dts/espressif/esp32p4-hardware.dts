/dts-v1/;

/ {
	model = "Espressif ESP32-P4 v1.3 IDF hardware handoff";
	compatible = "espressif,esp32p4-generic\0espressif,esp32p4";
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	chosen {
		ranges;
		bootargs = "clk_ignore_unused";
		#size-cells = <0x01>;
		#address-cells = <0x01>;
		espressif,cache-sync-entry = <0x00>;
		espressif,camera-service-entry = <0>;
		espressif,camera-invalidate-entry = <0>;
		espressif,cpu1-boot-mailbox = <0x00 0x1c>;
		espressif,chip-revision = <0x67>;
		stdout-path = "usbserial0:115200n8";

		framebuffer@49000000 {
			interrupts = <0x18 0x04>;
			interrupt-parent = <0x01>;
			espressif,ppa-service-entry = <0x00>;
			espressif,logical-framebuffer = <0x49200000 0xe1000 640 360 1280 720>;
			espressif,rotation-controller = <0x04>;
			espressif,scanout-controller = <0x03>;
			espressif,cache-writeback-entry = <0x00>;
			espressif,dsi-lli = <0x00>;
			espressif,panel-i2c = <&i2c1>;
			espressif,panel-i2c-address = <0x45>;
			status = "okay";
			format = "r5g6b5";
			stride = <0x5a0>;
			height = <0x500>;
			width = <0x2d0>;
			reg = <0x49000000 0x1c2000>;
			compatible = "espressif,esp32p4-idf-framebuffer";
		};
	};

	aliases {
		usbserial0 = &usb_serial_jtag;
		serial0 = "/soc/serial@500ca000";
	};

	memory@48000000 {
		device_type = "memory";
		reg = <0x48000000 0x1000000>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		framebuffer@49000000 {
			no-map;
			reg = <0x49000000 0x1c2000>;
		};

		landscape-framebuffer@49200000 {
			no-map;
			reg = <0x49200000 0xe1000>;
		};

		camera-buffers@49300000 {
			no-map;
			reg = <0x49300000 0x300000>;
		};

		boot-dtb@48f00000 {
			reg = <0x48f00000 0x10000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <0x15752a00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "espressif,esp32p4-cpu\0riscv";
			reg = <0x00>;
			status = "okay";
			riscv,isa = "rv32imafc_zicsr_zifencei_zicntr_zihpm_zcb_zcmp_zcmt";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i\0m\0a\0f\0c\0zicsr\0zifencei\0zicntr\0zihpm\0zmmul\0zaamo\0zalrsc\0zca\0zcb\0zcf\0zcmp\0zcmt";
			clock-frequency = <0x15752a00>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "espressif,esp32p4-cpu\0riscv";
			reg = <0x01>;
			status = "okay";
			riscv,isa = "rv32imafc_zicsr_zifencei_zicntr_zihpm_zcb_zcmp_zcmt";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i\0m\0a\0f\0c\0zicsr\0zifencei\0zicntr\0zihpm\0zmmul\0zaamo\0zalrsc\0zca\0zcb\0zcf\0zcmp\0zcmt";
			clock-frequency = <0x15752a00>;
		};
	};

	xtal: clock-xtal {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x2625a00>;
		phandle = <0x02>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		pixel-processor@50087000 {
			compatible = "espressif,esp32p4-idf-ppa";
			reg = <0x50087000 0x1000 0x50088000 0x1000>;
			interrupt-parent = <0x01>;
			interrupts = <105 4 108 4>;
			phandle = <0x04>;
		};

		display-controller@500a0000 {
			compatible = "espressif,esp32p4-idf-dsi";
			reg = <0x500a0000 0x1000 0x500e603c 0x04>;
			interrupt-parent = <0x01>;
			interrupts = <86 4>;
			phandle = <0x03>;
		};

		usb_serial_jtag: serial@500d2000 {
		compatible = "espressif,esp32p4-usb-serial-jtag";
		reg = <0x500d2000 0x1000>;
		interrupt-parent = <0x01>;
		interrupts = <22 4>;
		status = "okay";
	};

	interrupt-controller@20800000 {
			compatible = "espressif,esp32p4-interrupt-controller";
			reg = <0x20800000 0x12000 0x500d6000 0x1000 0x500e5000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x01>;
		};

		timer@500e2000 {
			compatible = "espressif,esp32p4-systimer";
			reg = <0x500e2000 0x1000 0x500e6000 0x1000>;
			interrupt-parent = <0x01>;
			interrupts = <0x35 0x04 0x36 0x04>;
		};

		serial@500ca000 {
			compatible = "espressif,esp32p4-uart";
			reg = <0x500ca000 0x1000>;
			clocks = <&xtal>;
			interrupt-parent = <0x01>;
			interrupts = <0x1f 0x04>;
			status = "okay";
		};

		/* Loader-configured I2C1 on SDA GPIO7 / SCL GPIO8. The 15-pin
		 * DSI connector has no touch INT wire, so Goodix uses its input
		 * polling mode. Transfers themselves complete through I2C IRQ45.
		 */
		i2c1: i2c@500c5000 {
			compatible = "espressif,esp32p4-idf-i2c";
			reg = <0x500c5000 0x1000>;
			interrupt-parent = <0x01>;
			interrupts = <45 4>;
			#address-cells = <1>;
			#size-cells = <0>;

            camera@36 {
                compatible = "espressif,esp32p4-ov5647";
                reg = <0x36>;
                interrupt-parent = <0x01>;
                interrupts = <24 4>;
            };

			backlight@45 {
				compatible = "raspberrypi,touch-display-2-backlight";
				reg = <0x45>;
			};

			touchscreen@5d {
				compatible = "goodix,gt911";
				reg = <0x5d>;
				touchscreen-size-x = <720>;
				touchscreen-size-y = <1280>;
				touchscreen-inverted-x;
				touchscreen-swapped-x-y;
				touchscreen-x-mm = <62>;
				touchscreen-y-mm = <110>;
			};
		};
	};
};
