config ESP32S31_DT_OVERLAY
	bool "ESP32-S31 transactional Device Tree overlay manager"
	depends on SOC_ESP32S31
	select OF_OVERLAY
	help
	  Exposes /dev/s31-overlay. A complete DTBO written to the device
	  replaces the currently active overlay. Replacement is transactional:
	  the previous overlay is restored if applying the new one fails.

config ESP32S31_RADIO_SMODE_DRIVER
	bool "ESP32-S31 S-mode radio runtime"
	depends on ESP32S31_RADIO_SMODE
	help
	  Start the radio kernel thread, provide the ESP-IDF compatibility runtime,
	  and dispatch the timer and modem interrupts delegated by OpenSBI.

config ESP32S31_RADIO_BLOBS
	bool "Link ESP-IDF Wi-Fi/Bluetooth firmware into the kernel"
	depends on ESP32S31_RADIO_SMODE
	help
	  Link the locally generated, ILP32F ESP-IDF radio payload into vmlinux.
	  Run the top-level radio-linux-payload target after updating ESP-IDF.

